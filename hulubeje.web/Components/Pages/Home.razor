                            class="hb-send-button">

                        <svg class="h-[16px] w-[16px]"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2.2"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M12 19V5" />

                            <path d="m6 11 6-6 6 6" />

