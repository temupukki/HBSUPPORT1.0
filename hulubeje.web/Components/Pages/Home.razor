                    {
                        <svg class="h-4 w-4"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <circle cx="12" cy="12" r="4" />

                            <path d="M12 3v2" />
                            <path d="M12 19v2" />
                            <path d="M3 12h2" />
                            <path d="M19 12h2" />

                        </svg>
                    }
                    else
                    {
                        <svg class="h-4 w-4"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3A6.7 6.7 0 0 0 21 12.8Z" />

