@code {

    private IReadOnlyList<SupportSession> Conversations =>
        SessionService.Sessions;

    private SupportSession? ActiveConversation =>
        SessionService.ActiveSession;

    private string Query { get; set; } = "";

    private bool Loading { get; set; }

    private bool IsRecording { get; set; }

    private bool VoiceProcessing { get; set; }

    private bool IsDark { get; set; }

    private bool SidebarCollapsed { get; set; }

    private bool MobileSidebarOpen { get; set; }

    private string? StreamingText { get; set; }

    private bool ShowDeleteAllDialog { get; set; }

    private const string StorageKey =
        "hulubeje_guest_sessions";

    private const string ThemeKey =
        "hulubeje_theme";


    /* ========================================================= */
    /* LOGO SOURCE — theme-aware                                  */
    /* ========================================================= */

    private string LogoSource =>
        IsDark
            ? "images/logo_dark.png"
            : "images/logo_light.png";


    /* ========================================================= */
    /* MARKDOWN CLEANER                                           */
    /* ========================================================= */

    private static string CleanAnswer(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return text;
        }

        var s = text
            .Replace("\r\n", "\n")
            .Replace("\r", "\n");

        // Fenced code blocks: remove the ``` markers
        s = Regex.Replace(s, @"```[a-zA-Z0-9_-]*\n?", "");

        // Bold: **text** → text
        s = Regex.Replace(s, @"\*\*(.+?)\*\*", "$1");

        // Underline-style bold: __text__ → text
        s = Regex.Replace(s, @"__(.+?)__", "$1");

        // Italic: *text* → text
        s = Regex.Replace(s, @"\*(.+?)\*", "$1");

        // Italic: _text_ → text
        s = Regex.Replace(s, @"_(.+?)_", "$1");

        // Inline code: `text` → text
        s = Regex.Replace(s, @"`(.+?)`", "$1");

        // Markdown headings: ### Heading → Heading
        s = Regex.Replace(s, @"^\s*#{1,6}\s+", "", RegexOptions.Multiline);

        // Bullets: "* item" or "- item" → "• item"
        s = Regex.Replace(s, @"^\s*[\*\-]\s+", "• ", RegexOptions.Multiline);

        // Leftover single asterisks
        s = s.Replace("*", "");

        // Leftover left/right bracket-style link syntax: [text](url) → text
        s = Regex.Replace(s, @"\[(.+?)\]\(.+?\)", "$1");

        // Collapse excessive blank lines
        s = Regex.Replace(s, @"\n{3,}", "\n\n");

        return s.Trim();
    }


    private async Task ScrollToBottom(bool smooth = true)
    {
        try
        {
            await JS.InvokeVoidAsync(
                "huluScroll.toBottom",
                "hb-chat-scroll",
                smooth
            );
        }
        catch { }
    }


    /* ========================================================= */
    /* THEME PERSISTENCE                                          */
    /* ========================================================= */

    private async Task LoadThemeAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                ThemeKey
            );

            if (stored == "dark")
            {
                IsDark = true;
            }
            else if (stored == "light")
            {
                IsDark = false;
            }
        }
        catch
        {
            // localStorage not available — keep default
        }
    }


    private async Task SaveThemeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                ThemeKey,
                IsDark ? "dark" : "light"
            );
        }
        catch
        {
            // best-effort
        }
    }


    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender) return;

        await LoadThemeAsync();

        var sessions =
            await BrowserStorage.GetAsync<
                List<SupportSession>
            >(StorageKey);

        if (sessions is not null &&
            sessions.Count > 0)
        {
            SessionService.RestoreSessions(sessions);
            SessionService.RemoveExpiredSessions();
            await SaveSessions();
        }

        if (SessionService.Sessions.Count == 0)
        {
            SessionService.CreateGuestSession();
            await SaveSessions();
        }

        await InvokeAsync(StateHasChanged);

        await ScrollToBottom(false);
    }


    private async Task CreateNewChat()
    {
        SessionService.CreateGuestSession();

        Query = "";
        StreamingText = null;
        IsRecording = false;
        VoiceProcessing = false;

        await SaveSessions();
        await InvokeAsync(StateHasChanged);
    }


    private async Task CreateNewChatFromMenu()
    {
        CloseMobileSidebar();
        await CreateNewChat();
    }


    private void SelectConversation(Guid id)
    {
        SessionService.SelectSession(id);
        Query = "";
        StreamingText = null;
    }


    private async Task SelectConversationFromMenu(Guid id)
    {
        CloseMobileSidebar();
        SelectConversation(id);

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom(false);
    }


    private async Task DeleteChat(Guid sessionId)
    {
        SessionService.DeleteSession(sessionId);

        if (SessionService.Sessions.Count == 0)
        {
            SessionService.CreateGuestSession();
        }

        Query = "";
        StreamingText = null;

        await SaveSessions();
        await InvokeAsync(StateHasChanged);
    }


