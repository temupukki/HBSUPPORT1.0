@code {

    /* ========================================================= */
    /* STATE                                                       */
    /* ========================================================= */

    private IReadOnlyList<SupportSession> Conversations =>
        SessionService.Sessions;

    private SupportSession? ActiveConversation =>
        SessionService.ActiveSession;

    private string Query { get; set; } = "";

    private bool Loading { get; set; }

    private bool IsRecording { get; set; }

    private bool VoiceProcessing { get; set; }

    private bool IsDark { get; set; }

    private bool SidebarCollapsed { get; set; }

    private bool MobileSidebarOpen { get; set; }

    private string? StreamingText { get; set; }

    private bool ShowDeleteAllDialog { get; set; }

    private const string StorageKey =
        "hulubeje_guest_sessions";


    /* ========================================================= */
    /* INITIALIZATION                                             */
    /* ========================================================= */

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var sessions =
            await BrowserStorage.GetAsync<
                List<SupportSession>
            >(StorageKey);

        if (sessions is not null &&
            sessions.Count > 0)
        {
            SessionService.RestoreSessions(
                sessions
            );

            SessionService.RemoveExpiredSessions();

            await SaveSessions();
        }

        if (SessionService.Sessions.Count == 0)
        {
            SessionService.CreateGuestSession();

            await SaveSessions();
        }

        await InvokeAsync(
            StateHasChanged
        );
    }


    /* ========================================================= */
    /* NEW CHAT                                                    */
    /* ========================================================= */

    private async Task CreateNewChat()
    {
        SessionService.CreateGuestSession();

        Query = "";

        StreamingText = null;

        IsRecording = false;

        VoiceProcessing = false;

        await SaveSessions();

        await InvokeAsync(
            StateHasChanged
        );
    }


    private async Task CreateNewChatFromMenu()
    {
        CloseMobileSidebar();

        await CreateNewChat();
    }


    /* ========================================================= */
    /* SELECT CHAT                                                */
    /* ========================================================= */

    private void SelectConversation(
        Guid id)
    {
        SessionService.SelectSession(id);

        Query = "";

        StreamingText = null;
    }


    private void SelectConversationFromMenu(
        Guid id)
    {
        CloseMobileSidebar();

        SelectConversation(id);
    }


    /* ========================================================= */
    /* DELETE CHAT                                                 */
    /* ========================================================= */

    private async Task DeleteChat(
        Guid sessionId)
    {
        SessionService.DeleteSession(
            sessionId
        );

        if (SessionService.Sessions.Count == 0)
        {
            SessionService.CreateGuestSession();
        }

        Query = "";

        StreamingText = null;

        await SaveSessions();

        await InvokeAsync(
            StateHasChanged
        );
    }


    /* ========================================================= */
    /* DELETE ALL                                                  */
    /* ========================================================= */

    private void OpenDeleteAllDialog()
    {
        ShowDeleteAllDialog = true;
    }


    private void CloseDeleteAllDialog()
    {
        ShowDeleteAllDialog = false;
    }


    private async Task ConfirmDeleteAllChats()
    {
        SessionService.DeleteAllSessions();

        SessionService.CreateGuestSession();

        Query = "";

        StreamingText = null;

        ShowDeleteAllDialog = false;

        await SaveSessions();

        await InvokeAsync(
            StateHasChanged
        );
    }


    /* ========================================================= */
    /* STORAGE                                                     */
    /* ========================================================= */

    private async Task SaveSessions()
    {
        var sessions =
            SessionService.GetSessionsForStorage();

        await BrowserStorage.SetAsync(
            StorageKey,
            sessions
        );
    }


    /* ========================================================= */
    /* SIDEBAR                                                     */
    /* ========================================================= */

    private void ToggleSidebar()
    {
        SidebarCollapsed =
            !SidebarCollapsed;
    }


    private void HandleSidebarCollapse()
    {
        SidebarCollapsed = true;

        MobileSidebarOpen = false;
    }


    private void ToggleMobileSidebar()
    {
        MobileSidebarOpen =
            !MobileSidebarOpen;
    }


    private void CloseMobileSidebar()
    {
        MobileSidebarOpen = false;
    }


    /* ========================================================= */
    /* THEME                                                       */
    /* ========================================================= */

    private void ToggleTheme()
    {
        IsDark = !IsDark;
    }


    /* ========================================================= */
    /* QUICK QUESTIONS                                             */
    /* ========================================================= */

    private Task StartDeliveryQuestion()
    {
        return UsePrompt(
            "How long does standard delivery take?"
        );
    }


    private Task StartReturnQuestion()
    {
        return UsePrompt(
            "What is the return and refund policy?"
        );
    }


    private Task StartPaymentQuestion()
    {
        return UsePrompt(
            "What payment and billing options are available?"
        );
    }


    private Task StartProductQuestion()
    {
        return UsePrompt(
            "Can you tell me about HuluBeje products?"
        );
    }


    private async Task UsePrompt(
        string prompt)
    {
        Query = prompt;

        await SendMessage();
    }


    /* ========================================================= */
    /* KEYBOARD                                                    */
    /* ========================================================= */

    private async Task HandleKeyDown(
        KeyboardEventArgs e)
    {
        if (e.Key == "Enter" &&
            !e.ShiftKey)
        {
            await SendMessage();
        }
    }


    /* ========================================================= */
    /* TEXT CHAT                                                   */
    /* ========================================================= */

    private async Task SendMessage()
    {
        if (!CanSend ||
            ActiveConversation is null)
        {
            return;
        }

        var userMessage =
            Query.Trim();

        if (string.IsNullOrWhiteSpace(
                userMessage))
        {
            return;
        }

        var conversationHistory =
            ActiveConversation.Messages
                .Select(message =>
                    new ConversationHistoryMessage
                    {
                        Role = message.Role,
                        Content = message.Content
                    }
                )
                .ToList();

        Query = "";

        Loading = true;

        SessionService.AddMessage(
            "user",
            userMessage
        );

        await InvokeAsync(
            StateHasChanged
        );

        try
        {
            var answer =
                await RagService.AskAsync(
                    userMessage,
                    conversationHistory
                );

            await StreamText(
                answer
            );

            SessionService.AddMessage(
                "assistant",
                answer
            );

            StreamingText = null;

            await SaveSessions();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"TEXT CHAT ERROR: {ex}"
            );

            StreamingText = null;

            SessionService.AddMessage(
                "assistant",
                "Sorry, something went wrong. Please try again."
            );

            await SaveSessions();
        }
        finally
        {
            Loading = false;

            await InvokeAsync(
                StateHasChanged
            );
        }
    }


    /* ========================================================= */
    /* VOICE                                                      */
    /* ========================================================= */

    private async Task ToggleVoiceRecording()
    {
        if (IsRecording)
        {
            await StopVoiceRecording();

            return;
        }

        await StartVoiceRecording();
    }


    private async Task StartVoiceRecording()
    {
        if (Loading ||
            VoiceProcessing)
        {
            return;
        }

        try
        {
            Console.WriteLine(
                "VOICE: Starting browser recording..."
            );

            IsRecording = true;

            await InvokeAsync(
                StateHasChanged
            );

            await JS.InvokeVoidAsync(
                "huluVoiceRecorder.start"
            );

            Console.WriteLine(
                "VOICE: Browser recording started."
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"VOICE START ERROR: {ex}"
            );

            IsRecording = false;

            await InvokeAsync(
                StateHasChanged
            );
        }
    }


   private async Task StopVoiceRecording()
{
    if (!IsRecording)
    {
        return;
    }

    try
    {
        IsRecording = false;

        VoiceProcessing = true;

        await InvokeAsync(
            StateHasChanged
        );

        Console.WriteLine(
            "VOICE: Stopping browser recording..."
        );

        await ProcessVoiceMessage();
    }
    catch (Exception ex)
    {
        Console.WriteLine(
            $"VOICE ERROR: {ex}"
        );

        StreamingText = null;

        if (ActiveConversation is not null)
        {
            SessionService.AddMessage(
                "assistant",
                "Sorry, something went wrong while processing your voice message."
            );

            await SaveSessions();
        }
    }
    finally
    {
        IsRecording = false;
        VoiceProcessing = false;

        await InvokeAsync(
            StateHasChanged
        );
    }
}

   private async Task ProcessVoiceMessage()
{
    if (ActiveConversation is null)
    {
        VoiceProcessing = false;
        return;
    }

    try
    {
        Console.WriteLine(
            "VOICE: Preparing conversation history..."
        );

        var conversationHistory =
            ActiveConversation.Messages
                .Select(message =>
                    new ConversationHistoryMessage
                    {
                        Role = message.Role,
                        Content = message.Content
                    }
                )
                .ToList();

        Console.WriteLine(
            "VOICE: Sending browser audio directly to FastAPI..."
        );

        var responseJson =
            await JS.InvokeAsync<string>(
                "huluVoiceRecorder.upload",
                TimeSpan.FromMinutes(2),
                conversationHistory
            );

        Console.WriteLine(
            "VOICE: Voice API response received."
        );

        var result =
            System.Text.Json.JsonSerializer
                .Deserialize<RagService.VoiceChatResponse>(
                    responseJson
                );

        if (result is null)
        {
            throw new InvalidOperationException(
                "Voice API returned an empty response."
            );
        }

        var transcription =
            result.Transcription?.Trim();

        var answer =
            result.Answer?.Trim();

        Console.WriteLine(
            $"VOICE: Transcription: {transcription}"
        );

        Console.WriteLine(
            $"VOICE: Answer length: {answer?.Length ?? 0}"
        );

        if (
            string.IsNullOrWhiteSpace(
                transcription
            )
        )
        {
            throw new InvalidOperationException(
                "The voice API returned an empty transcription."
            );
        }

        SessionService.AddMessage(
            "user",
            transcription
        );

        await InvokeAsync(
            StateHasChanged
        );

        if (
            !string.IsNullOrWhiteSpace(
                answer
            )
        )
        {
            await StreamText(
                answer
            );

            SessionService.AddMessage(
                "assistant",
                answer
            );

            StreamingText = null;
        }

        await SaveSessions();
    }
    catch (Exception ex)
    {
        Console.WriteLine(
            $"VOICE API ERROR: {ex}"
        );

        StreamingText = null;

        if (ActiveConversation is not null)
        {
            SessionService.AddMessage(
                "assistant",
                "Sorry, something went wrong while processing your voice message."
            );

            await SaveSessions();
        }
    }
    finally
    {
        IsRecording = false;
        VoiceProcessing = false;

        await InvokeAsync(
            StateHasChanged
        );
    }
}

    /* ========================================================= */
    /* STREAMING                                                   */
    /* ========================================================= */

    private async Task StreamText(
        string fullText)
    {
        if (string.IsNullOrEmpty(
                fullText))
        {
            return;
        }

        var length =
            fullText.Length;

        var chunkSize =
            Math.Max(
                1,
                length / 60
            );

        var totalSteps =
            (int)Math.Ceiling(
                (double)length /
                chunkSize
            );

        var duration =
            Math.Min(
                2200,
                Math.Max(
                    600,
                    length * 12
                )
            );

        var delay =
            Math.Max(
                12,
                duration / totalSteps
            );

        StreamingText = "";


        for (
            var i = 0;
            i < length;
            i += chunkSize)
        {
            var end =
                Math.Min(
                    i + chunkSize,
                    length
                );

            StreamingText =
                fullText[..end];

            await InvokeAsync(
                StateHasChanged
            );

            await Task.Delay(
                delay
            );
        }


        StreamingText =
            fullText;

        await InvokeAsync(
            StateHasChanged
        );
    }


