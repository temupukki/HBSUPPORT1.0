@page "/"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using System.Text.RegularExpressions
@using HuluBeje.Web.Models
@using HuluBeje.Web.Services

@inject SessionService SessionService
@inject BrowserStorageService BrowserStorage
@inject RagService RagService
@inject IJSRuntime JS

<PageTitle>HuluBeje Support</PageTitle>

<HeadContent>
    <script>
        window.huluScroll = {
            toBottom: function (elementId, smooth) {
                try {
                    var el = document.getElementById(elementId);
                    if (!el) return;
                    el.scrollTo({
                        top: el.scrollHeight,
                        behavior: smooth ? 'smooth' : 'auto'
                    });
                } catch (e) { }
            }
        };
    </script>
</HeadContent>

<style>

    /* ========================================================= */
    /* ROOT                                                       */
    /* ========================================================= */

    .hb-root {
        font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;

        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        background-color: var(--hb-bg);
        color: var(--hb-fg);
    }


    /* ========================================================= */
    /* ANIMATIONS                                                 */
    /* ========================================================= */

    @@keyframes hb-rise {
        0%   { opacity: 0; transform: translateY(8px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    @@keyframes hb-fade {
        0%   { opacity: 0; }
        100% { opacity: 1; }
    }

    @@keyframes hb-scale-in {
        0%   { opacity: 0; transform: scale(.94); }
        100% { opacity: 1; transform: scale(1); }
    }

    @@keyframes hb-dot {
        0%, 60%, 100% { opacity: .25; transform: translateY(0); }
        30%           { opacity: 1;    transform: translateY(-3px); }
    }

    @@keyframes hb-caret {
        0%, 45%   { opacity: 1; }
        55%, 100% { opacity: 0; }
    }

    @@keyframes hb-drawer-in {
        0%   { transform: translateX(-100%); }
        100% { transform: translateX(0); }
    }

    @@keyframes hb-voice-ring {
        0%   { box-shadow: 0 0 0 0    rgba(196, 56, 42, .45); }
        70%  { box-shadow: 0 0 0 10px rgba(196, 56, 42, 0);   }
        100% { box-shadow: 0 0 0 0    rgba(196, 56, 42, 0);   }
    }

    @@keyframes hb-voice-bar {
        0%, 100% { height: 6px;  opacity: .35; }
        50%      { height: 16px; opacity: 1;   }
    }

    @@keyframes hb-avatar-pulse {
        0%   { opacity: .55; transform: scale(.85); }
        100% { opacity: 0;   transform: scale(1.65); }
    }


    .hb-rise {
        animation: hb-rise 420ms cubic-bezier(.2, .7, .2, 1) both;
    }

    .hb-fade {
        animation: hb-fade 300ms ease both;
    }

    .hb-scale-in {
        animation: hb-scale-in 500ms cubic-bezier(.2, .7, .2, 1) both;
    }


    /* ========================================================= */
    /* THEME FADE                                                 */
    /* ========================================================= */

    .hb-theme-fade {
        transition:
            background-color 350ms ease,
            border-color 350ms ease,
            color 350ms ease;
    }


    /* ========================================================= */
    /* LOGO                                                       */
    /* ========================================================= */

    .hb-logo {
        display: block;
        object-fit: contain;
        user-select: none;
        -webkit-user-drag: none;

        transition: opacity 300ms ease;
    }


    /* ========================================================= */
    /* SIDEBAR                                                    */
    /* ========================================================= */

    .hb-sidebar {
        display: flex;
        flex-direction: column;

        width: 264px;

        overflow: hidden;

        will-change: width;

        transition:
            width 320ms cubic-bezier(.4, 0, .2, 1),
            transform 300ms cubic-bezier(.4, 0, .2, 1);
    }

    .hb-sidebar.hb-sidebar-collapsed {
        width: 64px;
    }


    .hb-sidebar-header {
        display: flex;
        align-items: center;
        gap: 8px;

        height: 64px;
        flex-shrink: 0;

        padding: 0 12px;

        transition:
            padding 320ms cubic-bezier(.4, 0, .2, 1),
            justify-content 320ms cubic-bezier(.4, 0, .2, 1);
    }

    .hb-sidebar-collapsed .hb-sidebar-header {
        padding: 0;
        justify-content: center;
    }

    .hb-brand {
        display: flex;
        align-items: center;
        gap: 10px;

        min-width: 0;
        flex: 1;

        padding: 0 6px;

        transition:
            padding 320ms cubic-bezier(.4, 0, .2, 1),
            gap 320ms cubic-bezier(.4, 0, .2, 1);
    }

    .hb-sidebar-collapsed .hb-brand {
        flex: 0 0 auto;
        padding: 0;
        gap: 0;
    }


    .hb-sidebar-text {
        overflow: hidden;
        white-space: nowrap;

        max-width: 220px;

        transition:
            opacity 180ms ease,
            max-width 320ms cubic-bezier(.4, 0, .2, 1);
    }

    .hb-sidebar-collapsed .hb-sidebar-text {
        opacity: 0;
        max-width: 0;
        pointer-events: none;
    }


    .hb-new-chat-wrap {
        flex-shrink: 0;
        padding: 8px 12px 16px 12px;
    }

    .hb-new-chat-btn {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;

        width: 100%;
        height: 40px;

        padding: 0 14px;

        border-radius: 10px;
        border: 1px solid var(--hb-line);

        background: var(--hb-surface);
        color: var(--hb-fg);

        font-family: inherit;
        font-size: 13px;
        font-weight: 500;

        cursor: pointer;

        transition:
            padding 320ms cubic-bezier(.4, 0, .2, 1),
            gap 320ms cubic-bezier(.4, 0, .2, 1),
            background-color 200ms ease,
            border-color 200ms ease,
            transform 200ms cubic-bezier(.2, .7, .2, 1),
            box-shadow 200ms ease;
    }

    .hb-new-chat-btn:hover {
        background: var(--hb-line-soft);
        transform: translateY(-1px);
        box-shadow: 0 8px 20px -12px rgba(0, 0, 0, .2);
    }

    .hb-new-chat-btn:active {
        transform: translateY(0);
        box-shadow: none;
    }

    .hb-new-chat-btn:focus-visible {
        outline: 2px solid var(--hb-accent);
        outline-offset: 2px;
    }

    .hb-new-chat-btn svg {
        flex-shrink: 0;
        transition: transform 260ms cubic-bezier(.2, .7, .2, 1);
    }

    .hb-new-chat-btn:hover svg {
        transform: rotate(90deg);
    }

    .hb-sidebar-collapsed .hb-new-chat-btn {
        padding: 0;
        gap: 0;
        justify-content: center;
    }

    .hb-sidebar-collapsed .hb-new-chat-btn:hover {
        transform: scale(1.06);
    }

    .hb-sidebar-collapsed .hb-new-chat-btn:active {
        transform: scale(.94);
    }


    .hb-sidebar-list {
        display: flex;
        flex-direction: column;

        flex: 1;
        min-height: 0;

        padding: 0 12px;

        transition:
            opacity 180ms ease,
            padding 320ms cubic-bezier(.4, 0, .2, 1);
    }

    .hb-sidebar-collapsed .hb-sidebar-list {
        opacity: 0;
        pointer-events: none;
    }

    .hb-list-label {
        padding: 8px 8px 10px 8px;

        font-size: 9px;
        letter-spacing: .18em;
        text-transform: uppercase;

        color: var(--hb-muted);
    }

    .hb-sidebar-scroll {
        flex: 1;
        min-height: 0;

        overflow-y: auto;

        padding-bottom: 8px;
        padding-right: 4px;
    }


    .hb-sidebar-footer {
        flex-shrink: 0;

        padding: 12px;

        border-top: 1px solid var(--hb-line);

        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .hb-theme-btn {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 10px;

        width: 100%;
        height: 36px;

        padding: 0 12px;

        border: 1px solid transparent;
        border-radius: 10px;

        background: transparent;
        color: var(--hb-muted);

        font-family: inherit;
        font-size: 12.5px;
        font-weight: 500;

        text-align: left;

        cursor: pointer;

        transition:
            padding 320ms cubic-bezier(.4, 0, .2, 1),
            gap 320ms cubic-bezier(.4, 0, .2, 1),
            background-color 180ms ease,
            color 180ms ease;
    }

    .hb-theme-btn:hover {
        background-color: var(--hb-line-soft);
        color: var(--hb-fg);
    }

    .hb-sidebar-collapsed .hb-theme-btn {
        padding: 0;
        gap: 0;
        justify-content: center;
    }


    /* ========================================================= */
    /* SCROLLBAR                                                  */
    /* ========================================================= */

    .hb-scroll::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .hb-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .hb-scroll::-webkit-scrollbar-thumb {
        background: var(--hb-line);
        border-radius: 999px;
    }

    .hb-scroll::-webkit-scrollbar-thumb:hover {
        background: var(--hb-muted);
    }


    /* ========================================================= */
    /* ICON BUTTON                                                */
    /* ========================================================= */

    .hb-icon-button {
        display: flex;

        height: 34px;
        width: 34px;

        flex-shrink: 0;

        align-items: center;
        justify-content: center;

        border-radius: 9px;

        color: var(--hb-muted);

        transition:
            background-color 180ms ease,
            color 180ms ease,
            transform 150ms ease;
    }

    .hb-icon-button:hover {
        background-color: var(--hb-line-soft);
        color: var(--hb-fg);
    }

    .hb-icon-button:active {
        transform: scale(.92);
    }


    /* ========================================================= */
    /* TOP BAR                                                    */
    /* ========================================================= */

    .hb-topbar {
        display: flex;
        align-items: center;
        gap: 10px;

        height: 60px;
        flex-shrink: 0;

        padding: 0 14px;
    }

    @@media (min-width: 640px) {
        .hb-topbar {
            height: 64px;
            padding: 0 20px;
            gap: 12px;
        }
    }

    @@media (min-width: 768px) {
        .hb-topbar {
            height: 68px;
            padding: 0 24px;
        }
    }

    .hb-topbar-title {
        min-width: 0;

        font-size: 14px;
        font-weight: 600;
        letter-spacing: -.005em;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (min-width: 768px) {
        .hb-topbar-title {
            font-size: 14.5px;
        }
    }


    /* ========================================================= */
    /* TOP BAR — WEBSITE LINK                                     */
    /* ========================================================= */

    .hb-topbar-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        height: 32px;
        flex-shrink: 0;

        padding: 0 10px;

        border-radius: 8px;

        color: var(--hb-muted);

        font-size: 12.5px;
        font-weight: 500;

        text-decoration: none;

        transition:
            background-color 180ms ease,
            color 180ms ease;
    }

    .hb-topbar-link:hover {
        background-color: var(--hb-line-soft);
        color: var(--hb-fg);
    }

    .hb-topbar-link svg {
        transition: transform 220ms cubic-bezier(.2, .7, .2, 1);
    }

    .hb-topbar-link:hover svg {
        transform: translate(1px, -1px);
    }


    /* ========================================================= */
    /* CONVERSATIONS                                              */
    /* ========================================================= */

    .hb-conversation {
        position: relative;
        margin-bottom: 2px;
    }

    .hb-conversation-button {
        display: flex;
        width: 100%;
        align-items: center;

        padding: 9px 34px 9px 10px;

        border-radius: 8px;

        text-align: left;

        color: var(--hb-fg);

        font-size: 12.5px;

        transition: background-color 180ms ease;
    }

    .hb-conversation-button:hover {
        background-color: var(--hb-line-soft);
    }

    .hb-conversation-button.hb-active {
        background-color: var(--hb-line-soft);
    }

    .hb-delete-button {
        position: absolute;

        right: 4px;
        top: 50%;

        transform: translateY(-50%);

        display: flex;

        height: 26px;
        width: 26px;

        align-items: center;
        justify-content: center;

        border-radius: 6px;

        color: var(--hb-muted);

        opacity: 0;

        pointer-events: none;

        transition:
            opacity 180ms ease,
            background-color 180ms ease,
            color 180ms ease;
    }

    .hb-conversation:hover .hb-delete-button,
    .hb-conversation:focus-within .hb-delete-button {
        opacity: 1;
        pointer-events: auto;
    }

    .hb-delete-button:hover {
        background-color: rgba(196, 56, 42, .10);
        color: var(--hb-accent);
    }


    /* ========================================================= */
    /* DANGER BUTTON                                              */
    /* ========================================================= */

    .hb-danger-button {
        display: flex;
        width: 100%;
        height: 36px;
        align-items: center;
        gap: 10px;

        padding: 0 12px;

        border-radius: 10px;

        color: var(--hb-muted);

        font-size: 12.5px;
        font-weight: 500;

        text-align: left;

        transition:
            background-color 180ms ease,
            color 180ms ease;
    }

    .hb-danger-button:hover {
        background-color: rgba(196, 56, 42, .08);
        color: var(--hb-accent);
    }


    /* ========================================================= */
    /* QUICK PROMPT PILLS                                         */
    /* ========================================================= */

    .hb-pill {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        padding: 10px 16px;

        border: 1px solid var(--hb-line);
        border-radius: 999px;

        background: var(--hb-surface);
        color: var(--hb-fg);

        font-size: 12.5px;

        cursor: pointer;

        transition:
            border-color 180ms ease,
            color 180ms ease,
            transform 180ms ease,
            box-shadow 180ms ease,
            background-color 350ms ease;
    }

    @@media (min-width: 640px) {
        .hb-pill {
            padding: 11px 18px;
            font-size: 13px;
        }
    }

    .hb-pill:hover {
        border-color: var(--hb-accent);
        color: var(--hb-accent);

        transform: translateY(-2px);

        box-shadow: 0 8px 22px -10px rgba(196, 56, 42, .4);
    }

    .hb-pill:active {
        transform: translateY(0);
    }


    /* ========================================================= */
    /* COMPOSER                                                   */
    /* ========================================================= */

    .hb-composer {
        display: flex;
        align-items: flex-end;
        gap: 4px;

        padding: 6px;

        border: 1px solid var(--hb-line);
        border-radius: 22px;

        background: var(--hb-surface);

        transition:
            border-color 200ms ease,
            box-shadow 200ms ease,
            background-color 350ms ease;
    }

    .hb-composer:focus-within {
        border-color: var(--hb-fg);
        box-shadow:
            0 0 0 3px var(--hb-line-soft),
            0 12px 32px -18px rgba(0, 0, 0, .25);
    }

    .theme-dark .hb-composer:focus-within {
        box-shadow:
            0 0 0 3px var(--hb-line-soft),
            0 12px 32px -14px rgba(0, 0, 0, .7);
    }

    .hb-composer-textarea {
        flex: 1;

        min-height: 24px;
        max-height: 180px;

        resize: none;

        border: 0;
        outline: none;

        background: transparent;

        padding: 10px 4px 10px 12px;

        color: var(--hb-fg);

        font-family: inherit;
        font-size: 14px;
        line-height: 1.5;
    }

    @@media (min-width: 640px) {
        .hb-composer-textarea {
            font-size: 14.5px;
            padding: 11px 6px 11px 14px;
        }
    }

    .hb-composer-textarea::placeholder {
        color: var(--hb-muted);
    }

    .hb-composer-textarea:disabled {
        opacity: .55;
        cursor: not-allowed;
    }


    /* ========================================================= */
    /* ACTION BUTTONS                                             */
    /* ========================================================= */

    .hb-action-button {
        display: flex;

        height: 38px;
        width: 38px;

        flex-shrink: 0;

        align-items: center;
        justify-content: center;

        border-radius: 50%;

        transition:
            background-color 180ms ease,
            color 180ms ease,
            opacity 180ms ease,
            transform 160ms cubic-bezier(.2, .7, .2, 1);
    }

    @@media (min-width: 640px) {
        .hb-action-button {
            height: 40px;
            width: 40px;
        }
    }

    .hb-action-button:active:not(:disabled) {
        transform: scale(.9);
    }

    .hb-voice-button {
        color: var(--hb-muted);
    }

    .hb-voice-button:hover:not(:disabled) {
        background-color: var(--hb-line-soft);
        color: var(--hb-fg);
    }

    .hb-voice-button:disabled {
        cursor: not-allowed;
        opacity: .4;
    }

    .hb-voice-recording {
        background-color: var(--hb-accent);
        color: var(--hb-btn-fg);

        animation: hb-voice-ring 1.5s cubic-bezier(.4, 0, .2, 1) infinite;
    }

    .hb-voice-recording:hover {
        background-color: var(--hb-accent);
        color: var(--hb-btn-fg);
    }

    .hb-send-button {
        background-color: var(--hb-accent);
        color: var(--hb-btn-fg);
        cursor: pointer;
    }

    .hb-send-button:hover:not(:disabled) {
        opacity: .92;
        transform: scale(1.05);
    }

    .hb-send-button:disabled {
        background-color: var(--hb-line);
        color: var(--hb-muted);

        cursor: not-allowed;
        opacity: .55;
    }


    /* ========================================================= */
    /* MESSAGES                                                   */
    /* ========================================================= */

    .hb-message-avatar {
        display: flex;

        height: 28px;
        width: 28px;

        flex-shrink: 0;

        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background-color: var(--hb-line-soft);
    }

    @@media (min-width: 640px) {
        .hb-message-avatar {
            height: 30px;
            width: 30px;
        }
    }

    .hb-message-body {
        max-width: 88%;
        padding-top: 3px;

        font-size: 14px;
        line-height: 1.7;

        white-space: pre-line;

        color: var(--hb-fg);
    }

    @@media (min-width: 640px) {
        .hb-message-body {
            max-width: 85%;
            font-size: 14.5px;
            line-height: 1.75;
        }
    }

    .hb-user-bubble {
        max-width: 85%;

        padding: 9px 14px;

        border-radius: 20px 20px 5px 20px;

        background-color: var(--hb-accent);
        color: var(--hb-user-fg);

        font-size: 14px;
        line-height: 1.6;

        white-space: pre-line;

        box-shadow: 0 3px 12px -6px rgba(196, 56, 42, .35);
    }

    @@media (min-width: 640px) {
        .hb-user-bubble {
            max-width: 76%;
            padding: 10px 16px;
            font-size: 14.5px;
            border-radius: 22px 22px 5px 22px;
        }
    }


    /* ========================================================= */
    /* LOADING DOTS                                               */
    /* ========================================================= */

    .hb-loading-dots {
        display: flex;
        align-items: center;
        gap: 4px;
        padding-top: 12px;
    }

    .hb-loading-dots span {
        height: 5px;
        width: 5px;

        border-radius: 50%;

        background-color: var(--hb-muted);

        animation: hb-dot 1.2s ease-in-out infinite;
    }

    .hb-loading-dots span:nth-child(2) { animation-delay: .15s; }
    .hb-loading-dots span:nth-child(3) { animation-delay: .3s; }


    /* ========================================================= */
    /* STREAMING CARET                                            */
    /* ========================================================= */

    .hb-caret {
        display: inline-block;
        width: 2px;
        height: 15px;
        margin-left: 3px;
        vertical-align: -2px;
        background-color: var(--hb-fg);
        animation: hb-caret 900ms steps(1) infinite;
    }


    /* ========================================================= */
    /* VOICE PROCESSING                                           */
    /* ========================================================= */

    .hb-processing-message {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        animation: hb-rise 320ms cubic-bezier(.2, .7, .2, 1) both;
    }

    .hb-processing-avatar {
        position: relative;
        display: flex;
        height: 30px;
        width: 30px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: var(--hb-line-soft);
        overflow: visible;
    }

    .hb-processing-avatar::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2px solid var(--hb-accent);
        opacity: 0;
        pointer-events: none;
        animation: hb-avatar-pulse 2s cubic-bezier(.4, 0, .2, 1) infinite;
    }

    .hb-processing-body {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 5px;
    }

    .hb-voice-bars {
        display: flex;
        align-items: center;
        gap: 3px;
        height: 18px;
    }

    .hb-voice-bars span {
        display: block;
        width: 3px;
        height: 6px;
        border-radius: 2px;
        background-color: var(--hb-accent);
        animation: hb-voice-bar 1.1s ease-in-out infinite;
    }

    .hb-voice-bars span:nth-child(1) { animation-delay: 0s;    }
    .hb-voice-bars span:nth-child(2) { animation-delay: .13s; }
    .hb-voice-bars span:nth-child(3) { animation-delay: .26s; }
    .hb-voice-bars span:nth-child(4) { animation-delay: .39s; }
    .hb-voice-bars span:nth-child(5) { animation-delay: .52s; }

    .hb-processing-text {
        font-size: 13.5px;
        color: var(--hb-muted);
        letter-spacing: -.005em;
    }


    /* ========================================================= */
    /* MODAL                                                      */
    /* ========================================================= */

    .hb-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(0, 0, 0, .4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        animation: hb-fade 200ms ease both;
    }

    .hb-modal {
        width: 100%;
        max-width: 400px;
        border: 1px solid var(--hb-line);
        border-radius: 20px;
        background: var(--hb-surface);
        color: var(--hb-fg);
        box-shadow: 0 24px 72px rgba(0, 0, 0, .24);
        animation: hb-scale-in 300ms cubic-bezier(.2, .7, .2, 1) both;
    }


    /* ========================================================= */
    /* RESPONSIVE HELPERS                                         */
    /* ========================================================= */

    .hb-only-mobile  { display: flex; }
    .hb-only-desktop { display: none; }

    @@media (min-width: 768px) {
        .hb-only-mobile  { display: none !important; }
        .hb-only-desktop { display: flex; }
    }


    /* ========================================================= */
    /* MOBILE SIDEBAR                                             */
    /* ========================================================= */

    .hb-mobile-backdrop {
        display: none;
    }

    @@media (max-width: 767.98px) {

        .hb-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 280px !important;
            z-index: 60;
            transform: translateX(-100%);
            box-shadow: 8px 0 40px rgba(0, 0, 0, .22);
        }

        .hb-sidebar.hb-mobile-open {
            animation: hb-drawer-in 320ms cubic-bezier(.4, 0, .2, 1) both;
        }

        .hb-mobile-backdrop {
            display: block;
            position: fixed;
            inset: 0;
            z-index: 55;
            background: rgba(0, 0, 0, .45);
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            animation: hb-fade 200ms ease both;
        }

        .hb-sidebar-collapsed .hb-sidebar-header {
            padding: 0 12px !important;
            justify-content: flex-start !important;
        }

        .hb-sidebar-collapsed .hb-brand {
            flex: 1 !important;
            padding: 0 6px !important;
            gap: 10px !important;
        }

        .hb-sidebar-collapsed .hb-sidebar-text {
            opacity: 1 !important;
            max-width: 220px !important;
            pointer-events: auto !important;
        }

        .hb-sidebar-collapsed .hb-new-chat-btn {
            padding: 0 14px !important;
            gap: 10px !important;
            justify-content: flex-start !important;
        }

        .hb-sidebar-collapsed .hb-sidebar-list {
            opacity: 1 !important;
            pointer-events: auto !important;
        }

        .hb-sidebar-collapsed .hb-theme-btn {
            padding: 0 12px !important;
            gap: 10px !important;
            justify-content: flex-start !important;
        }
    }


    /* ========================================================= */
    /* TINY PHONES                                                */
    /* ========================================================= */

    @@media (max-width: 420px) {

        .hb-pill {
            width: 100%;
            justify-content: center;
        }

        .hb-user-bubble {
            max-width: 90%;
        }

        .hb-message-body {
            max-width: 90%;
        }

        .hb-topbar-link span {
            display: none;
        }

        .hb-topbar-link {
            padding: 0 8px;
        }
    }


    /* ========================================================= */
    /* REDUCED MOTION                                             */
    /* ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .hb-rise,
        .hb-fade,
        .hb-scale-in,
        .hb-voice-ring,
        .hb-voice-bar,
        .hb-avatar-pulse,
        .hb-mobile-backdrop,
        .hb-sidebar.hb-mobile-open,
        .hb-processing-message,
        .hb-loading-dots span,
        .hb-processing-dot {
            animation: none !important;
        }

        .hb-theme-fade,
        .hb-sidebar,
        .hb-sidebar-header,
        .hb-brand,
        .hb-sidebar-text,
        .hb-new-chat-wrap,
        .hb-new-chat-btn,
        .hb-sidebar-list,
        .hb-theme-btn,
        .hb-topbar-link,
        .hb-pill,
        .hb-icon-button,
        .hb-delete-button,
        .hb-danger-button,
        .hb-conversation-button,
        .hb-composer,
        .hb-action-button,
        .hb-logo {
            transition: none !important;
        }
    }

</style>


<div class="hb-root hb-theme-fade @ThemeClass flex h-screen overflow-hidden"
     style="@ThemeVariables">


    <!-- MOBILE BACKDROP -->
    @if (MobileSidebarOpen)
    {
        <div class="hb-mobile-backdrop"
             @onclick="CloseMobileSidebar">
        </div>
    }


    <!-- SIDEBAR -->

    <aside class="hb-sidebar @SidebarClass @(MobileSidebarOpen ? "hb-mobile-open" : "")"
           style="background-color: var(--hb-sidebar);">

        <div class="hb-sidebar-header">

            <div class="hb-brand">

                <img src="@LogoSource"
                     alt="HuluBeje"
                     class="hb-logo h-12 w-20 shrink-0" />

            </div>


            @if (!SidebarCollapsed)
            {
                <button @onclick="HandleSidebarCollapse"
                        title="Collapse sidebar"
                        class="hb-icon-button hb-only-desktop">

                    <svg class="h-4 w-4"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <path d="M15 6l-6 6 6 6" />

                    </svg>

                </button>
            }


            <button @onclick="CloseMobileSidebar"
                    title="Close menu"
                    class="hb-icon-button hb-only-mobile">

                <svg class="h-4 w-4"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M6 6l12 12M18 6L6 18" />

                </svg>

            </button>

        </div>


        <div class="hb-new-chat-wrap">

            <button @onclick="CreateNewChatFromMenu"
                    class="hb-new-chat-btn">

                <svg class="h-[15px] w-[15px] shrink-0"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M12 5v14M5 12h14" />

                </svg>

                <span class="hb-sidebar-text">
                    New chat
                </span>

            </button>

        </div>


        <div class="hb-sidebar-list">

            <div class="hb-list-label hb-mono">
                Chats
            </div>


            <div class="hb-sidebar-scroll hb-scroll">

                @if (Conversations.Count == 0)
                {
                    <div class="px-2 py-3 text-[12.5px]"
                         style="color: var(--hb-muted);">

                        No conversations yet.

                    </div>
                }
                else
                {
                    @foreach (var conversation in Conversations)
                    {
                        <div class="hb-conversation">

                            <button @onclick="() => SelectConversationFromMenu(conversation.Id)"
                                    class="@GetConversationClass(conversation.Id)">

                                <span class="min-w-0 flex-1 truncate">
                                    @conversation.Title
                                </span>

                            </button>


                            <button @onclick="() => DeleteChat(conversation.Id)"
                                    @onclick:stopPropagation="true"
                                    title="Delete conversation"
                                    class="hb-delete-button">

                                <svg class="h-[13px] w-[13px]"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.9">

                                    <path d="M3 6h18" />
                                    <path d="M8 6V4h8v2" />
                                    <path d="M19 6l-1 14H6L5 6" />
                                    <path d="M10 11v5" />
                                    <path d="M14 11v5" />

                                </svg>

                            </button>

                        </div>
                    }
                }

            </div>

        </div>


        <div class="hb-sidebar-footer">

            @if (ShowSidebarContent)
            {
                <button @onclick="OpenDeleteAllDialog"
