            "mx-auto flex h-9 w-9 items-center justify-center rounded-lg transition-colors duration-200 hover:bg-[var(--hb-line-soft)]"
            :
            "flex h-9 w-full items-center gap-2.5 rounded-lg px-3 text-left text-[12.5px] font-medium transition-colors duration-200 hover:bg-[var(--hb-line-soft)]";


    private string GetConversationClass(
        Guid id)
    {
        return ActiveConversation?.Id == id
            ? "hb-conversation-button hb-active"
            : "hb-conversation-button";
    }


    /* ========================================================= */
    /* SEND STATE                                                  */
    /* ========================================================= */

    private bool CanSend =>
        !Loading &&
        !IsRecording &&
        !VoiceProcessing &&
        ActiveConversation is not null &&
        !string.IsNullOrWhiteSpace(Query);

}