    private async Task SendMessage()
    {
        if (!CanSend || ActiveConversation is null) return;

        var userMessage = Query.Trim();

        if (string.IsNullOrWhiteSpace(userMessage)) return;

        var conversationHistory =
            ActiveConversation.Messages
                .Select(message =>
                    new ConversationHistoryMessage
                    {
                        Role = message.Role,
                        Content = message.Content
                    })
                .ToList();

        Query = "";
        Loading = true;

        SessionService.AddMessage("user", userMessage);

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();

        try
        {
            var answer = await RagService.AskAsync(
                userMessage,
                conversationHistory
            );

            // ── Clean markdown before streaming & saving ──
            answer = CleanAnswer(answer);

            await StreamText(answer);

            SessionService.AddMessage("assistant", answer);

            StreamingText = null;

            await SaveSessions();
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"TEXT CHAT ERROR: {ex}");

            StreamingText = null;

            SessionService.AddMessage(
                "assistant",
                "Sorry, something went wrong. Please try again."
            );

            await SaveSessions();
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task ToggleVoiceRecording()
