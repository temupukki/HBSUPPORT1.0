                                                 alt="HuluBeje"
                                                 class="hb-logo h-[18px] w-[18px]" />

                                        </div>

                                        <div class="max-w-[88%] whitespace-pre-line pt-1 text-[14.5px] leading-[1.75] sm:max-w-[85%]">

                                            @message.Content

                                        </div>

                                    </div>
                                }
                            }
                        }


                        <!-- ================================================= -->
                        <!-- TEXT RESPONSE STREAM                              -->
                        <!-- ================================================= -->

                        @if (!string.IsNullOrWhiteSpace(StreamingText))
                        {
                            <div class="flex items-start gap-3">

                                <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full"
                                     style="background-color: var(--hb-line-soft);">

                                    <img src="images/hulu-logo.png"
                                         alt="HuluBeje"
                                         class="hb-logo h-[18px] w-[18px]" />

                                </div>


                                <div class="max-w-[88%] whitespace-pre-line pt-1 text-[14.5px] leading-[1.75] sm:max-w-[85%]">

                                    @StreamingText

                                    <span class="hb-caret"></span>

                                </div>

                            </div>
                        }


                        <!-- ================================================= -->
                        <!-- NORMAL TEXT LOADING                              -->
                        <!-- ================================================= -->

                        @if (Loading &&
                            !VoiceProcessing &&
                            string.IsNullOrWhiteSpace(StreamingText))
                        {
                            <div class="hb-fade flex items-start gap-3">

                                <div class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full"
                                     style="background-color: var(--hb-line-soft);">

                                    <img src="images/hulu-logo.png"
                                         alt="HuluBeje"
                                         class="hb-logo h-[18px] w-[18px]" />

                                </div>


                                <div class="flex items-center gap-1 pt-3.5">

                                    <span class="h-1.5 w-1.5 rounded-full hb-dot"
                                          style="background-color: var(--hb-muted);">
                                    </span>

                                    <span class="h-1.5 w-1.5 rounded-full hb-dot"
                                          style="background-color: var(--hb-muted);">
                                    </span>

                                    <span class="h-1.5 w-1.5 rounded-full hb-dot"
                                          style="background-color: var(--hb-muted);">
                                    </span>

                                </div>

                            </div>
                        }


                        <!-- ================================================= -->
                        <!-- VOICE PROCESSING                                  -->
                        <!-- ================================================= -->

                        @if (VoiceProcessing)
                        {
                            <div class="hb-processing-message">

                                <div class="hb-processing-avatar">

                                    <img src="images/hulu-logo.png"
                                         alt="HuluBeje"
                                         class="hb-logo h-[18px] w-[18px]" />

                                </div>


                                <div class="hb-processing-bubble">

                                    <div class="hb-processing-spinner"></div>


                                    <div class="hb-processing-text">

                                        <span>
                                            Processing your voice message
                                        </span>

                                        <span class="hb-processing-dot">
                                            .
                                        </span>

                                        <span class="hb-processing-dot">
                                            .
                                        </span>

                                        <span class="hb-processing-dot">
                                            .
                                        </span>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </section>


        <!-- ========================================================= -->
        <!-- COMPOSER                                                   -->
        <!-- ========================================================= -->

        <div class="shrink-0 px-4 pb-4 pt-2 sm:px-6 sm:pb-6 md:px-8">

            <div class="mx-auto max-w-3xl">


                <div class="hb-composer">

                    <textarea @bind="Query"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              rows="1"
                              disabled="@(Loading || IsRecording || VoiceProcessing)"
                              placeholder="Ask HuluBeje anything..."
                              class="hb-composer-textarea hb-scroll">
                    </textarea>


                    <!-- ================================================= -->
                    <!-- VOICE BUTTON                                      -->
                    <!-- ================================================= -->

                    <button @onclick="ToggleVoiceRecording"
                            disabled="@(Loading || VoiceProcessing)"
                            aria-label="@(IsRecording ? "Stop recording" : "Voice input")"
                            title="@(IsRecording ? "Stop recording" : "Voice input")"
                            class="hb-voice-button @(IsRecording ? "hb-voice-recording" : "")">

                        @if (IsRecording)
                        {
                            <svg class="h-[16px] w-[16px]"
