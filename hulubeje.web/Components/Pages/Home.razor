    private async Task StartVoiceRecording()
    {
        if (Loading || VoiceProcessing) return;

        try
        {
            Console.WriteLine("VOICE: Starting browser recording...");

            IsRecording = true;

            await InvokeAsync(StateHasChanged);

            await JS.InvokeVoidAsync("huluVoiceRecorder.start");

            Console.WriteLine("VOICE: Browser recording started.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"VOICE START ERROR: {ex}");

            IsRecording = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task StopVoiceRecording()
    {
        if (!IsRecording) return;

        try
        {
            IsRecording = false;
            VoiceProcessing = true;

            await InvokeAsync(StateHasChanged);
            await ScrollToBottom(false);

            Console.WriteLine("VOICE: Stopping browser recording...");

            await ProcessVoiceMessage();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"VOICE ERROR: {ex}");

            StreamingText = null;

            if (ActiveConversation is not null)
            {
                SessionService.AddMessage(
                    "assistant",
                    "Sorry, something went wrong while processing your voice message."
                );

                await SaveSessions();
            }
        }
        finally
        {
            IsRecording = false;
            VoiceProcessing = false;

            await InvokeAsync(StateHasChanged);
        }
    }


   private async Task ProcessVoiceMessage()
    {
        if (ActiveConversation is null)
        {
            VoiceProcessing = false;
            return;
        }

        try
        {
            Console.WriteLine("VOICE: Preparing conversation history...");

            var conversationHistory =
                ActiveConversation.Messages
                    .Select(message =>
                        new ConversationHistoryMessage
                        {
                            Role = message.Role,
                            Content = message.Content
                        })
                    .ToList();

            Console.WriteLine("VOICE: Sending browser audio directly to FastAPI...");

            // 🎤 Create a real CancellationToken Source to survive long local AI workloads
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(3));

            // The CancellationToken must come exactly as the SECOND argument
            var responseJson =
                await JS.InvokeAsync<string>(
                    "huluVoiceRecorder.upload",
                    cts.Token, // 👈 Placed here to satisfy the compiler and hold the connection
                    conversationHistory
                );

            Console.WriteLine("VOICE: Voice API response received.");

            // 🛠️ FIX: Add case-insensitive options so C# matches lowercase Python JSON keys
            var serializationOptions = new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };

            var result =
                System.Text.Json.JsonSerializer
                    .Deserialize<RagService.VoiceChatResponse>(responseJson, serializationOptions);

            if (result is null)
            {
                throw new InvalidOperationException(
                    "Voice API returned an empty response."
                );
            }

            var transcription = result.Transcription?.Trim();
            var answer = result.Answer?.Trim();

            Console.WriteLine($"VOICE: Transcription: {transcription}");
            Console.WriteLine($"VOICE: Answer length: {answer?.Length ?? 0}");

            if (string.IsNullOrWhiteSpace(transcription))
            {
                throw new InvalidOperationException(
                    "The voice API returned an empty transcription."
                );
            }

            SessionService.AddMessage("user", transcription);

            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();

            if (!string.IsNullOrWhiteSpace(answer))
            {
                // ── Clean markdown before streaming & saving ──
                answer = CleanAnswer(answer);

                await StreamText(answer);

                SessionService.AddMessage("assistant", answer);

                StreamingText = null;
            }

            await SaveSessions();
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"VOICE API ERROR: {ex}");

            StreamingText = null;

            if (ActiveConversation is not null)
            {
                SessionService.AddMessage(
                    "assistant",
                    "Sorry, something went wrong while processing your voice message."
                );

                await SaveSessions();
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }
        }
        finally
        {
            IsRecording = false;
            VoiceProcessing = false;

            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task StreamText(string fullText)
    {
        if (string.IsNullOrEmpty(fullText)) return;

        var length = fullText.Length;
        var chunkSize = Math.Max(1, length / 60);
        var totalSteps = (int)Math.Ceiling((double)length / chunkSize);
        var duration = Math.Min(2200, Math.Max(600, length * 12));
        var delay = Math.Max(12, duration / totalSteps);

        StreamingText = "";

        var iteration = 0;

        for (var i = 0; i < length; i += chunkSize)
        {
            var end = Math.Min(i + chunkSize, length);

            StreamingText = fullText[..end];

            await InvokeAsync(StateHasChanged);

            iteration++;

            if (iteration % 4 == 0)
            {
                await ScrollToBottom(false);
            }

            await Task.Delay(delay);
        }

        StreamingText = fullText;

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom(false);
    }


