<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <Target Name="StartTailwind" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
  <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;if (-not (Get-Process node -ErrorAction SilentlyContinue | Where-Object { $_.CommandLine -like '*tailwindcss*' })) { Start-Process powershell -ArgumentList '-NoProfile -ExecutionPolicy Bypass -Command &quot;&quot;npx tailwindcss@3 -i ./wwwroot/css/tailwind.css -o ./wwwroot/css/app.css --watch&quot;&quot;' -WindowStyle Hidden }&quot;" />
  </Target>

</Project>
